{
  "name": "@weship/bot",
  "version": "0.0.0",
  "description": "Telegram bot for crypto portfolio management",
  "private": true,
  "scripts": {
    "build": "tsup --minify",
    "build:dev": "tsup",
    "check-types": "tsc --noEmit",
    "dev": "tsx watch ./src/index.ts",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "lint": "eslint src/ --max-warnings 150",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier . --ignore-path .gitignore --write --tab-width 2",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "type": "module",
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/env": "^5.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/sensible": "^6.0.1",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@fastify/under-pressure": "^9.0.3",
    "@gquittet/graceful-server": "^5.2.14",
    "@hpke/chacha20poly1305": "^1.7.1",
    "@hpke/core": "^1.7.4",
    "@langchain/community": "^0.3.27",
    "@langchain/core": "^0.3.36",
    "@langchain/google-genai": "^0.1.9",
    "@langchain/groq": "^0.1.3",
    "@langchain/langgraph": "^0.2.41",
    "@langchain/langgraph-checkpoint": "^0.0.16",
    "@langchain/langgraph-checkpoint-postgres": "^0.0.4",
    "@langchain/mcp-adapters": "^0.3.4",
    "@langchain/ollama": "^0.2.0",
    "@langchain/textsplitters": "^0.1.0",
    "@napi-rs/canvas": "^0.1.77",
    "@meteora-ag/dlmm": "^1.7.0",
    "@prisma/adapter-neon": "^6.5.0",
    "@prisma/client": "^6.3.0",
    "@privy-io/server-auth": "^1.31.1",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "@t3-oss/env-core": "^0.12.0",
    "@telegraf/entity": "^0.7.0",
    "@types/mime-types": "^2.1.4",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "bn.js": "^5.2.2",
    "bottleneck": "^2.19.5",
    "bs58": "^6.0.0",
    "bullmq": "^5.58.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.4",
    "electron-log": "^5.2.4",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.7.0",
    "mime-types": "^2.1.35",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "superjson": "^2.2.2",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.16",
    "uuid": "^11.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@telegraf/types": "^9.0.0",
    "@types/bn.js": "^5.2.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.7.3",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@weship/eslint-config": "workspace:^",
    "@weship/typescript-config": "workspace:^",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "prisma": "^6.3.0",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=8.15.6"
  }
}
