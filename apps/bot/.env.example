# Meteora Liquidity Provision Assistant - Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meteora_bot

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# comment line below if dev mode for polling mode :D
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook 


# Privy https://dashboard.privy.io/apps/
PRIVY_APP_ID="your app id"
PRIVY_APP_SECRET="your secret"
# https://dashboard.privy.io/apps/<app_id>/authorization-keys
PRIVI_SIGNERS_ID="signer id" 

# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta
# Alternative for devnet: https://api.devnet.solana.com

# Meteora SDK Configuration
METEORA_API_URL=https://dlmm-api.meteora.ag

# Redis Configuration (for Bull Queue)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Encryption (for wallet private keys)
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Auto-rebalancing Configuration
REBALANCE_INTERVAL_MINUTES=60
DEFAULT_REBALANCE_THRESHOLD=5.0
MAX_GAS_PRICE_SOL=0.01

# Monitoring and Logging
LOG_LEVEL=info
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Security
JWT_SECRET=your_jwt_secret_here
CORS_ORIGIN=*