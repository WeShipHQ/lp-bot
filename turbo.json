{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "src/**/*",
        "tsconfig.json",
        "tsup.config.ts"
      ],
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".vercel/**",
        "build/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "cache": true
    },
    "test": {
      "inputs": [
        "src/**/*",
        "**/*.test.*",
        "**/*.spec.*",
        "jest.config.*",
        "vitest.config.*"
      ],
      "outputs": ["coverage/**"],
      "dependsOn": ["^build"],
      "cache": true
    },
    "lint": {
      "inputs": [
        "src/**/*",
        "eslint.config.*",
        ".eslintrc.*"
      ],
      "dependsOn": ["^build"],
      "cache": true
    },
    "check-types": {
      "inputs": [
        "src/**/*",
        "tsconfig.json"
      ],
      "dependsOn": ["^build"],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
